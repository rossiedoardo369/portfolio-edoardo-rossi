From eec3bcf6d0b7530ba58f6d9b15e066e1549f280d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 26 Jul 2026 22:40:36 +0000
Subject: [PATCH] Add SEO fundamentals: OG image, sitemap/robots.txt, JSON-LD
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add a branded 1200x630 OG/Twitter card image, complete Open Graph
and Twitter Card meta tags, a canonical link per page, a Person
JSON-LD schema, and sitemap.xml + robots.txt via @astrojs/sitemap
(pinned to sitemap@7.1.1 via npm overrides — newer sitemap releases
reject the absolute destinationDir that @astrojs/sitemap@2 passes,
which otherwise crashes the build).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0156tmxiXPUvZYocdjvjAUyi
---
 astro.config.mjs             |   4 +-
 package-lock.json            | 311 ++++++++++++++++++++++-------------
 package.json                 |   4 +
 public/og-image.png          | Bin 0 -> 48892 bytes
 public/robots.txt            |   4 +
 src/layouts/BaseLayout.astro |  38 ++++-
 6 files changed, 241 insertions(+), 120 deletions(-)
 create mode 100644 public/og-image.png
 create mode 100644 public/robots.txt

diff --git a/astro.config.mjs b/astro.config.mjs
index 54e72b8..4456f27 100644
--- a/astro.config.mjs
+++ b/astro.config.mjs
@@ -1,4 +1,5 @@
 import { defineConfig } from 'astro/config';
+import sitemap from '@astrojs/sitemap';
 
 // ATTENZIONE: aggiorna questi due valori prima del deploy su GitHub Pages.
 // Se il repo si chiama "portfolio-edoardo-rossi" e lo username GitHub è "rossiedoardo":
@@ -8,5 +9,6 @@ import { defineConfig } from 'astro/config';
 // lascia base: '/' e site con l'URL della user page.
 export default defineConfig({
   site: 'https://rossiedoardo369.github.io',
-base: '/portfolio-edoardo-rossi-2/',
+  base: '/portfolio-edoardo-rossi-2/',
+  integrations: [sitemap()],
 });
