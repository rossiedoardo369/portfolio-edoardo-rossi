---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  // true quando il componente è già dentro un elemento con classe
  // "container" (es. l'<article> di CaseStudyLayout) — evita di
  // applicare il padding orizzontale una seconda volta.
  nested?: boolean;
}

const { nested = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contactHref = `${base}${lang}/contact/`;
---
<section class={`closing-cta ${nested ? '' : 'container'}`}>
  <h2>{t('closing.h2')}</h2>
  <p>{t('closing.body')}</p>
  <a class="btn btn-primary" href={contactHref}>{t('closing.cta')}</a>
</section>

<style>
  .closing-cta {
    padding-block: var(--space-5) var(--space-6);
    border-top: var(--border);
    max-width: 40rem;
  }
  .btn {
    display: inline-block;
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.95rem;
    border: var(--border);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .btn-primary {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }
  .btn-primary:hover { background: var(--color-accent); border-color: var(--color-accent); }
</style>
