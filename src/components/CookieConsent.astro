---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="cookie-banner" id="cookie-banner" role="dialog" aria-modal="false" aria-labelledby="cookie-title" hidden>
  <div class="cookie-panel">
    <div class="cookie-summary" id="cookie-summary">
      <p class="mono cookie-eyebrow" id="cookie-title">{t('cookie.title')}</p>
      <p class="cookie-body">{t('cookie.body')}</p>
      <div class="cookie-actions">
        <button type="button" class="btn btn-ghost" id="cookie-customize">{t('cookie.customize')}</button>
        <button type="button" class="btn btn-ghost" id="cookie-reject">{t('cookie.rejectAll')}</button>
        <button type="button" class="btn btn-primary" id="cookie-accept">{t('cookie.acceptAll')}</button>
      </div>
    </div>

    <div class="cookie-detail" id="cookie-detail" hidden>
      <div class="cookie-category">
        <div class="cookie-category-head">
          <p class="cookie-category-title">{t('cookie.necessary.title')}</p>
          <span class="cookie-toggle-locked mono" aria-hidden="true">ON</span>
        </div>
        <p class="cookie-category-body">{t('cookie.necessary.body')}</p>
      </div>

      <div class="cookie-category">
        <div class="cookie-category-head">
          <label class="cookie-category-title" for="cookie-toggle-analytics">{t('cookie.analytics.title')}</label>
          <input type="checkbox" id="cookie-toggle-analytics" class="cookie-toggle" />
        </div>
        <p class="cookie-category-body">{t('cookie.analytics.body')}</p>
      </div>

      <div class="cookie-category">
        <div class="cookie-category-head">
          <label class="cookie-category-title" for="cookie-toggle-marketing">{t('cookie.marketing.title')}</label>
          <input type="checkbox" id="cookie-toggle-marketing" class="cookie-toggle" />
        </div>
        <p class="cookie-category-body">{t('cookie.marketing.body')}</p>
      </div>

      <div class="cookie-actions">
        <button type="button" class="btn btn-ghost" id="cookie-back">{t('cookie.back')}</button>
        <button type="button" class="btn btn-primary" id="cookie-save">{t('cookie.save')}</button>
      </div>
    </div>
  </div>
</div>

<button type="button" class="cookie-fab" id="cookie-fab" aria-label={t('cookie.manage')} title={t('cookie.manage')} hidden>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="3.2" />
    <path d="M12 3v2.2M12 18.8V21M4.9 4.9l1.55 1.55M17.55 17.55l1.55 1.55M3 12h2.2M18.8 12H21M4.9 19.1l1.55-1.55M17.55 6.45l1.55-1.55" />
  </svg>
</button>

<script>
  type Consent = { analytics: boolean; marketing: boolean };
  const STORAGE_KEY = 'cookieConsent';

  declare global {
    interface Window {
      dataLayer: unknown[];
      gtag: (...args: unknown[]) => void;
    }
  }

  function pushConsentUpdate(consent: Consent) {
    // gtag() è definita in BaseLayout, prima di questo script: stesso
    // meccanismo usato per il consenso di default, così GTM lo riconosce.
    window.dataLayer = window.dataLayer || [];
    window.gtag =
      window.gtag ||
      function () {
        window.dataLayer.push(arguments);
      };
    window.gtag('consent', 'update', {
      analytics_storage: consent.analytics ? 'granted' : 'denied',
      ad_storage: consent.marketing ? 'granted' : 'denied',
      ad_user_data: consent.marketing ? 'granted' : 'denied',
      ad_personalization: consent.marketing ? 'granted' : 'denied',
    });
  }

  function readStoredConsent(): Consent | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (typeof parsed?.analytics === 'boolean' && typeof parsed?.marketing === 'boolean') {
        return { analytics: parsed.analytics, marketing: parsed.marketing };
      }
      return null;
    } catch {
      return null;
    }
  }

  function storeConsent(consent: Consent) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...consent, updatedAt: Date.now() }));
    } catch {
      // localStorage non disponibile: la scelta vale solo per la sessione corrente.
    }
  }

  const banner = document.getElementById('cookie-banner');
  const summary = document.getElementById('cookie-summary');
  const detail = document.getElementById('cookie-detail');
  const fab = document.getElementById('cookie-fab');
  const analyticsToggle = document.getElementById('cookie-toggle-analytics') as HTMLInputElement | null;
  const marketingToggle = document.getElementById('cookie-toggle-marketing') as HTMLInputElement | null;

  function showBanner(openDetail = false) {
    if (!banner || !summary || !detail) return;
    const stored = readStoredConsent();
    if (analyticsToggle) analyticsToggle.checked = stored?.analytics ?? false;
    if (marketingToggle) marketingToggle.checked = stored?.marketing ?? false;
    summary.hidden = openDetail;
    detail.hidden = !openDetail;
    banner.hidden = false;
    if (fab) fab.hidden = true;
  }

  function hideBanner() {
    if (!banner) return;
    banner.hidden = true;
    // Il pulsantino ancorato resta disponibile solo dopo una prima scelta:
    // finché il banner non è mai stato chiuso non c'è ancora nulla da
    // "modificare".
    if (fab && readStoredConsent()) fab.hidden = false;
  }

  function applyChoice(consent: Consent) {
    storeConsent(consent);
    pushConsentUpdate(consent);
    hideBanner();
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    applyChoice({ analytics: true, marketing: true });
  });
  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    applyChoice({ analytics: false, marketing: false });
  });
  document.getElementById('cookie-customize')?.addEventListener('click', () => {
    if (!summary || !detail) return;
    summary.hidden = true;
    detail.hidden = false;
  });
  document.getElementById('cookie-back')?.addEventListener('click', () => {
    if (!summary || !detail) return;
    summary.hidden = false;
    detail.hidden = true;
  });
  document.getElementById('cookie-save')?.addEventListener('click', () => {
    applyChoice({
      analytics: analyticsToggle?.checked ?? false,
      marketing: marketingToggle?.checked ?? false,
    });
  });

  document.getElementById('cookie-manage-link')?.addEventListener('click', (e) => {
    e.preventDefault();
    showBanner(false);
  });
  fab?.addEventListener('click', () => showBanner(true));

  if (readStoredConsent()) {
    if (fab) fab.hidden = false;
  } else {
    showBanner(false);
  }
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: var(--space-2);
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-panel {
    width: 100%;
    max-width: 42rem;
    background: var(--color-surface);
    border: var(--border);
    box-shadow: 0 -4px 24px rgba(20, 24, 28, 0.12);
    padding: var(--space-3);
  }
  .cookie-eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0 0 0.4rem 0;
  }
  .cookie-body {
    margin: 0 0 var(--space-2) 0;
    font-size: 0.92rem;
    color: var(--color-ink-soft);
  }
  .cookie-actions {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .cookie-actions .btn {
    padding: 0.55rem 1rem;
    font-size: 0.88rem;
  }

  .cookie-category {
    border-top: var(--border);
    padding-block: var(--space-2);
  }
  .cookie-category:first-child {
    border-top: none;
    padding-top: 0;
  }
  .cookie-category-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .cookie-category-title {
    font-weight: 500;
    font-size: 0.95rem;
    margin: 0;
  }
  .cookie-category-body {
    margin: 0.3rem 0 0 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .cookie-toggle-locked {
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }
  .cookie-toggle {
    width: 2.4rem;
    height: 1.4rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  #cookie-detail .cookie-actions {
    margin-top: var(--space-2);
  }

  @media (max-width: 640px) {
    .cookie-actions { justify-content: stretch; }
    .cookie-actions .btn { flex: 1; text-align: center; }
  }

  .cookie-fab {
    position: fixed;
    left: var(--space-2);
    bottom: var(--space-2);
    z-index: 40;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    color: var(--color-ink-soft);
    border: var(--border);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .cookie-fab:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .cookie-fab[hidden] {
    display: none;
  }
</style>
