---
import { getLangFromUrl, useTranslations, translatedPaths } from '../i18n/utils';

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'en' ? `${base}en/` : base;

const localizedHref = (path: string) => (lang === 'en' ? `${base}en/${path}` : `${base}${path}`);

const nav = [
  { label: t('nav.work'), href: localizedHref('work/') },
  { label: t('nav.expertise'), href: localizedHref('expertise/') },
  { label: t('nav.experience'), href: localizedHref('experience/') },
  { label: t('nav.about'), href: localizedHref('about/') },
  { label: t('nav.contact'), href: localizedHref('contact/') },
];

const pathWithoutBase = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;
const restPath = lang === 'en' ? pathWithoutBase.replace(/^en\/?/, '') : pathWithoutBase;
const switchHref = translatedPaths.includes(restPath)
  ? (lang === 'en' ? `${base}${restPath}` : `${base}en/${restPath}`)
  : (lang === 'en' ? base : `${base}en/`);
---
<header class="site-header">
  <div class="container bar">
    <a href={homeHref} class="wordmark">Edoardo Rossi</a>
    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label={t('nav.menuOpen')}
      data-open-label={t('nav.menuOpen')}
      data-close-label={t('nav.menuClose')}
    >
      <span class="menu-icon"></span>
    </button>
    <nav aria-label={t('nav.mainAria')} id="primary-nav">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a class="lang-switch" href={switchHref} hreflang={lang === 'en' ? 'it' : 'en'}>{t('nav.langSwitch')}</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('primary-nav');

  const openLabel = toggle?.dataset.openLabel ?? 'Apri il menu';
  const closeLabel = toggle?.dataset.closeLabel ?? 'Chiudi il menu';

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? closeLabel : openLabel);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', openLabel);
    });
  });

  // Una scelta esplicita dello switcher vale più della lingua del browser:
  // viene ricordata, così il redirect automatico la rispetta da qui in poi.
  const langSwitch = document.querySelector<HTMLAnchorElement>('.lang-switch');
  langSwitch?.addEventListener('click', () => {
    try {
      localStorage.setItem('preferredLang', langSwitch.hreflang);
    } catch {
      // localStorage non disponibile (modalità privata, ecc.): nessun problema,
      // lo switcher continua a funzionare, solo senza persistenza.
    }
  });
</script>

<style>
  .site-header {
    border-bottom: var(--border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
  }
  nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--color-ink-soft);
    padding-bottom: 0.25rem;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    border: var(--border);
    border-radius: var(--radius);
    padding: 0.2rem 0.5rem;
    color: var(--color-ink);
  }
  .lang-switch::after { display: none; }
  .lang-switch:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border: var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--color-ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-icon {
    position: relative;
    margin: 0 auto;
  }
  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-icon::before { top: -6px; }
  .menu-icon::after { top: 6px; }

  .menu-toggle[aria-expanded="true"] .menu-icon {
    background: transparent;
  }
  .menu-toggle[aria-expanded="true"] .menu-icon::before {
    top: 0;
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .menu-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 640px) {
    .bar { flex-wrap: wrap; }
    .menu-toggle { display: block; }

    nav {
      display: none;
      width: 100%;
      order: 1;
    }
    nav.is-open {
      display: block;
      padding-bottom: var(--space-2);
    }
    nav ul {
      flex-direction: column;
      gap: var(--space-1);
    }
    nav a {
      display: block;
      padding-block: var(--space-1);
    }
    nav a.lang-switch {
      display: inline-block;
      margin-top: var(--space-1);
    }
  }
</style>
