---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<footer class="site-footer">
  <div class="container">
    <img
      src={`${base}logo-horizontal.svg`}
      alt="Edoardo Rossi — Performance Marketing & Digital Strategy"
      class="footer-logo"
      width="1600"
      height="260"
      loading="lazy"
    />
    <div class="bar">
      <p class="mono small">© {year} Edoardo Rossi</p>
      <ul class="links">
        <li><a href="https://www.linkedin.com/in/rossiedoardo369" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="mailto:rossi.edoardo369@gmail.com">Email</a></li>
        <li><a href="#" id="cookie-manage-link">{t('cookie.manage')}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border);
    margin-top: var(--space-6);
  }
  .footer-logo {
    display: block;
    height: 30px;
    width: auto;
    margin-top: var(--space-3);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .small { font-size: 0.85rem; color: var(--color-ink-soft); margin: 0; }
  .links {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a { font-size: 0.9rem; }

  @media (max-width: 640px) {
    .footer-logo { height: 22px; }
  }
</style>
