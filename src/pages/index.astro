---
import BaseLayout from '../layouts/BaseLayout.astro';
import { caseStudies } from '../data/case-studies.js';

const base = import.meta.env.BASE_URL;

const heroH1 = 'Ogni euro speso in advertising dovrebbe poter rispondere a una domanda: cosa ha prodotto, esattamente?';
const heroWords = heroH1.split(' ');

const steps = [
  {
    n: '01',
    title: 'Strategia',
    body: 'Discovery diretta con il cliente: individuo il posizionamento e l’obiettivo di business reale, non solo quello pubblicitario.',
  },
  {
    n: '02',
    title: 'Esecuzione',
    body: 'Creatività, struttura della campagna, automazioni e integrazione con CRM e team commerciale — dal primo contatto in poi.',
  },
  {
    n: '03',
    title: 'Misurazione',
    body: 'Reportistica che risale fino al risultato di business — cliente acquisito, fatturato, ritorno reale — non si ferma al click.',
  },
];
---
<BaseLayout
  title="Home"
  description="Performance Marketing & Digital Strategy Specialist — campagne Google e Meta misurate dal primo contatto al risultato di business."
  translated
>
  <section class="hero container">
    <p class="eyebrow">Performance Marketing &amp; Digital Strategy Specialist</p>
    <h1 aria-label={heroH1}>
      <span aria-hidden="true">
        {heroWords.map((w, i) => (
          <Fragment><span class="word">{w}</span>{i < heroWords.length - 1 ? ' ' : ''}</Fragment>
        ))}
      </span>
    </h1>
    <p class="lede">
      Progetto e conduco campagne su Google e Meta, dal primo contatto pubblicitario fino alla
      decisione finale del cliente — con la reportistica a dimostrarlo, non solo a raccontarlo.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={`${base}work/`}>Guarda i case studies</a>
      <a class="btn btn-ghost" href={`${base}contact/`}>Contattami</a>
    </div>
  </section>

  <section class="proof container" aria-label="Risultati principali">
    <div class="proof-track" id="proof-track">
      {caseStudies.map((c, i) => (
        <a class="proof-card fade-in" style={`--delay: ${i * 80}ms`} href={`${base}work/${c.slug}/`}>
          <p class="mono metric" data-value={c.metric}>0</p>
          <p class="proof-label">{c.metricLabel}</p>
          <p class="proof-context">{c.title}</p>
          <p class="proof-cta card-cta">Leggi di più →</p>
        </a>
      ))}
    </div>
    <div class="proof-controls">
      <button type="button" class="slider-arrow" id="proof-prev" aria-label="Caso precedente">←</button>
      <button type="button" class="slider-arrow" id="proof-next" aria-label="Caso successivo">→</button>
    </div>
  </section>

  <section class="how container">
    <h2>Come lavoro</h2>
    <ol class="steps">
      {steps.map((step, i) => (
        <li class="fade-in" style={`--delay: ${i * 60}ms`}>
          <span class="mono step-n">{step.n}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="closing container fade-in">
    <h2>Ti ho già convinto? Allora cosa aspetti?</h2>
    <p>
      Hai appena visto risultati misurati, non promesse. Se cerchi lo stesso approccio — dati alla
      mano, dal primo contatto al risultato di business — sono a disposizione per parlarne.
    </p>
    <a class="btn btn-primary" href={`${base}contact/`}>Contattami →</a>
  </section>
</BaseLayout>

<script>
  // Rivelazione parola per parola dell'h1 al caricamento (non allo scroll:
  // la hero è già visibile appena si apre la pagina). L'opacity iniziale
  // viene impostata da qui, non da CSS: se lo script non parte per
  // qualunque motivo, il testo resta semplicemente visibile da subito
  // invece di sparire — l'h1 porta comunque l'aria-label con la frase
  // intera, quindi per chi usa uno screen reader il contenuto non cambia.
  const heroWordEls = document.querySelectorAll<HTMLElement>('.hero h1 .word');
  heroWordEls.forEach((el, i) => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(6px)';
    const duration = 300;
    function frame(now: number, start: number) {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.style.opacity = String(eased);
      el.style.transform = `translateY(${(1 - eased) * 6}px)`;
      if (t < 1) {
        requestAnimationFrame((n) => frame(n, start));
      } else {
        el.style.opacity = '';
        el.style.transform = '';
      }
    }
    setTimeout(() => requestAnimationFrame((now) => frame(now, now)), i * 25);
  });

  const track = document.getElementById('proof-track');
  const prev = document.getElementById('proof-prev') as HTMLButtonElement | null;
  const next = document.getElementById('proof-next') as HTMLButtonElement | null;

  function step(): number {
    const card = track?.querySelector<HTMLElement>('.proof-card');
    if (!track || !card) return 300;
    const gap = parseFloat(getComputedStyle(track).columnGap || '0');
    return card.getBoundingClientRect().width + gap;
  }

  function updateArrows() {
    if (!track || !prev || !next) return;
    const maxScroll = track.scrollWidth - track.clientWidth;
    const atEnd = track.scrollLeft >= maxScroll - 1;
    prev.disabled = track.scrollLeft <= 1;
    next.disabled = atEnd;
    track.classList.toggle('at-end', atEnd);
  }

  prev?.addEventListener('click', () => {
    track?.scrollBy({ left: -step(), behavior: 'smooth' });
  });
  next?.addEventListener('click', () => {
    track?.scrollBy({ left: step(), behavior: 'smooth' });
  });

  track?.addEventListener('scroll', updateArrows, { passive: true });
  window.addEventListener('resize', updateArrows);
  updateArrows();

  // Il fade-in on-scroll (.fade-in) è gestito globalmente da BaseLayout.

  // Animazione dei numeri al primo ingresso in viewport
  function animateValue(el: HTMLElement) {
    const raw = el.dataset.value || '';
    const match = raw.match(/^([+−]?)(\d+(?:,\d+)?)(.*)$/);
    if (!match) {
      el.textContent = raw;
      return;
    }
    const [, sign, numStr, suffix] = match;
    const decimals = numStr.includes(',') ? numStr.split(',')[1].length : 0;
    const target = parseFloat(numStr.replace(',', '.'));
    const duration = 1500;
    let start: number | null = null;

    function frame(now: number) {
      if (start === null) start = now;
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      const current = target * eased;
      el.textContent = sign + current.toLocaleString('it-IT', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      }) + suffix;
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  const metrics = document.querySelectorAll<HTMLElement>('.proof-card .metric');
  const isMobile = window.matchMedia('(max-width: 780px)').matches;

  if (isMobile) {
    // Su mobile è visibile una card alla volta: ognuna parte quando è
    // interamente a schermo (dopo che lo scroll-snap si è assestato).
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateValue(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 1 });
    metrics.forEach((el) => observer.observe(el));
  } else {
    // Su desktop più card sono visibili insieme: partono tutte insieme
    // non appena la prima card entra in vista.
    const firstMetric = metrics[0];
    if (firstMetric) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            metrics.forEach((el) => animateValue(el));
            observer.disconnect();
          }
        });
      }, { threshold: 0.4 });
      observer.observe(firstMetric);
    }
  }
</script>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
    max-width: 46rem;
  }
  .hero h1 .word { display: inline-block; }
  .lede {
    font-size: 1.15rem;
    max-width: 38rem;
  }
  .cta-row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .btn {
    display: inline-block;
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.95rem;
    border: var(--border);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.1s ease;
  }
  .btn:active { transform: scale(0.97); }
  .btn-primary {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }
  .btn-primary:hover { background: var(--color-accent); border-color: var(--color-accent); }
  .btn-ghost { color: var(--color-ink); }
  .btn-ghost:hover { color: var(--color-accent); border-color: var(--color-accent); }

  .proof {
    padding-block: var(--space-4) var(--space-5);
    border-top: var(--border);
    border-bottom: var(--border);
  }
  .proof-track {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--space-1);
    padding-bottom: var(--space-1);
    scrollbar-width: none;
    mask-image: linear-gradient(to right, black calc(100% - 48px), transparent);
    -webkit-mask-image: linear-gradient(to right, black calc(100% - 48px), transparent);
    transition: mask-image 0.2s ease, -webkit-mask-image 0.2s ease;
  }
  .proof-track.at-end {
    mask-image: none;
    -webkit-mask-image: none;
  }
  .proof-track::-webkit-scrollbar { display: none; }
  .proof-card {
    display: block;
    scroll-snap-align: start;
    flex: 0 0 auto;
    width: clamp(220px, 26vw, 300px);
    padding: var(--space-3);
    background: var(--color-surface);
    border: var(--border);
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color 0.2s ease, transform 0.1s ease;
  }
  .proof-card:hover { border-color: var(--color-accent); }
  .proof-card:active { transform: scale(0.98); }
  .metric {
    font-size: 2.1rem;
    font-weight: 500;
    color: var(--color-accent);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .proof-label {
    font-family: var(--font-display);
    font-size: 0.95rem;
    margin: 0.2rem 0 0.6rem 0;
  }
  .proof-context {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-2) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .proof-cta {
    font-size: 0.85rem;
    margin: 0;
  }
  .proof-card:hover .proof-cta {
    color: var(--color-accent);
    text-decoration: underline;
    transform: scale(1.04);
  }
  .proof-controls {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .slider-arrow {
    width: 2.5rem;
    height: 2.5rem;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 1.1rem;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }
  .slider-arrow:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .slider-arrow:disabled {
    opacity: 0.35;
    cursor: default;
    border-color: var(--color-line);
    color: var(--color-ink);
  }
  .slider-arrow:disabled:hover { border-color: var(--color-line); color: var(--color-ink); }

  .how { padding-block: var(--space-6); }
  .steps {
    list-style: none;
    margin: var(--space-3) 0 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-2);
    border-top: var(--border);
    padding-top: var(--space-3);
  }
  .step-n { color: var(--color-caution-text); font-size: 1rem; }
  .steps h3 { margin-bottom: 0.3rem; }
  .steps p { margin: 0; }

  .closing {
    padding-block: var(--space-5) var(--space-6);
    border-top: var(--border);
    max-width: 40rem;
  }

  @media (max-width: 780px) {
    .proof-card { width: clamp(200px, 68vw, 280px); }
  }
</style>
