---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Pagina non trovata"
  description="La pagina cercata non esiste o è stata spostata."
>
  <section class="notfound container">
    <p class="eyebrow">404</p>
    <h1>Questa pagina non esiste.</h1>
    <p>
      Il link potrebbe essere errato o la pagina essere stata spostata.
      Puoi ripartire dalla home o andare direttamente ai case study.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={base}>Torna alla home</a>
      <a class="btn btn-ghost" href={`${base}work/`}>Lavori selezionati</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound { padding-block: var(--space-6); max-width: 40rem; }
  .cta-row { display: flex; gap: var(--space-2); margin-top: var(--space-3); flex-wrap: wrap; }
  .btn {
    display: inline-block;
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.95rem;
    border: var(--border);
  }
  .btn-primary { background: var(--color-ink); color: var(--color-bg); border-color: var(--color-ink); }
  .btn-primary:hover { background: var(--color-accent); border-color: var(--color-accent); }
  .btn-ghost { color: var(--color-ink); }
</style>
