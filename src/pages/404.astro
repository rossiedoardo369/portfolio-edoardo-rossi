---
// GitHub Pages serve esclusivamente questo file su qualsiasi 404 del sito
// (Astro emette `dist/404.html` solo per la route `/404`, non per `/it/404`
// o `/en/404`). È quindi l'unico punto in cui si può decidere in che lingua
// mostrare l'errore, e lo fa smistando verso le due 404 localizzate — che
// esistono già complete di header, nav e footer.
//
// Niente BaseLayout qui: header, footer, GTM e banner cookie non hanno senso
// su una pagina che rimbalza in pochi millisecondi. Il markup sotto è il
// fallback per chi non esegue JS e per i bot, ed è bilingue proprio perché
// in quel caso non c'è nessuno a scegliere la lingua.
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pagina non trovata · Page not found — Edoardo Rossi</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline define:vars={{ base }}>
      // La lingua la dà l'URL sbagliata, non il browser: chi stava navigando
      // sotto /en/ deve restare in inglese. Stessa logica di getLangFromUrl().
      // `from` conserva l'URL rotta, che altrimenti si perderebbe nel passaggio
      // a /it/404/ — è il dato che serve per accorgersi dei link rotti in giro.
      (function () {
        try {
          var path = location.pathname;
          var rest = path.indexOf(base) === 0 ? path.slice(base.length) : path;

          // Se siamo già su una delle due 404 localizzate qualcosa non ha
          // funzionato: meglio fermarsi qui che rimbalzare all'infinito.
          if (rest.indexOf('it/404') === 0 || rest.indexOf('en/404') === 0) return;

          var lang = rest === 'en' || rest.indexOf('en/') === 0 ? 'en' : 'it';
          var from = '?from=' + encodeURIComponent(path + location.search);
          location.replace(base + lang + '/404/' + from);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="notfound container">
      <p class="eyebrow">404</p>

      <section>
        <h1>Questa pagina non esiste.</h1>
        <p>Il link potrebbe essere errato o la pagina essere stata spostata.</p>
        <p class="links">
          <a href={`${base}it/`}>Torna alla home</a>
          <span aria-hidden="true">·</span>
          <a href={`${base}it/work/`}>Lavori selezionati</a>
        </p>
      </section>

      <section lang="en">
        <h2>This page doesn't exist.</h2>
        <p>The link might be wrong, or the page may have moved.</p>
        <p class="links">
          <a href={`${base}en/`}>Back to home</a>
          <span aria-hidden="true">·</span>
          <a href={`${base}en/work/`}>Selected work</a>
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  .notfound { padding-block: var(--space-6); max-width: 40rem; }
  .notfound section + section {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border);
  }
  .notfound h2 { font-size: clamp(2.1rem, 4vw + 1rem, 3.4rem); }
  .links { margin-bottom: 0; }
  .links span { color: var(--color-line); padding-inline: 0.4rem; }
</style>
