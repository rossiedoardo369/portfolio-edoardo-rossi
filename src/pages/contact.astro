---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const faqs = [
  {
    q: 'Con che tipo di realtà lavora Edoardo Rossi?',
    a: 'Agenzie, aziende e team interni interessati a un approccio misurato: campagne Google e Meta seguite dal primo contatto pubblicitario fino al risultato di business, non solo al click.',
  },
  {
    q: 'Perché i case studies sono tutti in ambito odontoiatrico?',
    a: 'È una specializzazione verticale scelta, non un limite. Il metodo — discovery diretta, misurazione end-to-end, integrazione con CRM — si applica allo stesso modo ad altri settori regolamentati o ad alto valore per lead.',
  },
  {
    q: 'Lavora anche con clienti fuori dall’Italia?',
    a: 'Sì. Il sito è bilingue italiano/inglese proprio per questo: è aperto a collaborazioni a distanza con clienti e team che comunicano in inglese, fusi orari compatibili inclusi.',
  },
  {
    q: 'Quali canali pubblicitari gestisce?',
    a: 'Principalmente Google Ads (Search, Performance Max, Display) e Meta Ads, con misurazione GA4/Google Tag Manager e integrazione CRM quando serve tracciare il lead oltre il click.',
  },
  {
    q: 'Qual è il modo migliore per contattarlo?',
    a: 'Email o LinkedIn — i link sono qui sotto.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Contatti"
  description="Contatta Edoardo Rossi per collaborazioni, progetti e opportunità di lavoro nel performance marketing e nella digital strategy."
  translated
>
  <section class="contact container">
    <p class="eyebrow">Contatti</p>
    <h1>Se il mio modo di lavorare ti convince, parliamone.</h1>
    <p class="lede">
      Sono aperto a collaborare con qualsiasi realtà — agenzie, aziende, team interni — interessata
      non solo alle competenze che porto, ma al modo in cui lavoro: metodo, misurazione, onestà sui
      risultati. Se hai letto i <a href={`${base}work/`}>case studies</a> e ti ritrovi in questo approccio, partiamo da qui.
    </p>

    <div class="channels">
      <a class="channel fade-in" href="mailto:rossi.edoardo369@gmail.com">
        <p class="mono channel-label">Email</p>
        <p class="channel-value">rossi.edoardo369@gmail.com</p>
      </a>
      <a class="channel fade-in" style="--delay: 80ms" href="https://www.linkedin.com/in/rossiedoardo369" target="_blank" rel="noopener">
        <p class="mono channel-label">LinkedIn</p>
        <p class="channel-value">linkedin.com/in/rossiedoardo369</p>
      </a>
    </div>

    <div class="faq">
      <h2>Domande frequenti</h2>
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>

<style>
  .contact { padding-block: var(--space-6); max-width: 46rem; }
  .lede { font-size: 1.15rem; }

  .channels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .channel {
    display: block;
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-3);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.1s ease;
  }
  .channel:hover { border-color: var(--color-accent); }
  .channel:active { transform: scale(0.98); }
  .channel-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }
  .channel-value {
    margin: 0;
    font-size: 1rem;
    color: var(--color-ink);
    text-decoration: none;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }
  .channel:hover .channel-value { text-decoration: underline; }

  @media (max-width: 640px) {
    .channels { grid-template-columns: 1fr; }
  }

  .faq {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--border);
  }
  .faq h2 { margin-bottom: var(--space-3); }
  .faq-item {
    padding-block: var(--space-2);
    border-top: var(--border);
  }
  .faq-item:first-of-type { border-top: none; }
  .faq-item h3 { font-size: 1rem; margin-bottom: 0.3rem; }
  .faq-item p { margin: 0; font-size: 0.95rem; }
</style>
