---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import { caseStudiesEn } from '../../data/case-studies.js';

const base = import.meta.env.BASE_URL;
const yearsActive = new Date().getFullYear() - 2021;

const roles = [
  {
    period: '2025 — present',
    title: 'Digital Advertising Specialist',
    org: 'Marketing Therapy — marketing agency',
    points: [
      'Managing Google and Meta campaigns across a multi-client portfolio, from strategy to reporting.',
      'Tracking and data analysis with GTM and GA4, CRM integration.',
      'Client discovery, campaign copywriting, video scripts and coordination with videographers and the creative team.',
      'Training client teams on lead management and building automation flows.',
    ],
  },
  {
    period: '2023 — 2024',
    title: 'Junior Digital Marketing Specialist',
    org: 'Floris s.r.l. — B2B company',
    points: [
      'Supporting the design of online and offline marketing strategies in a complex B2B sector.',
      'CRO optimization through UX and UI work.',
      'Assisting with tracking and data analysis.',
    ],
  },
  {
    period: '2021 — 2023',
    title: 'Digital Marketing Intern',
    org: 'Floris s.r.l.',
    points: [
      'Creating content for company social channels (Meta, LinkedIn, blog).',
      'Lead generation strategies through email marketing and PPC campaigns.',
      'Managing the company website.',
    ],
  },
];

const education = [
  {
    period: '2021 — 2023',
    title: 'Higher Technical Certificate in Digital Marketing',
    points: 'Marketing fundamentals, applied projects, in-company training placements.',
  },
  {
    period: '2018 — 2022',
    title: 'Bachelor’s Degree in Communication Sciences',
    points: 'Cognitive aspects of communication, persuasive language strategies for traditional and digital media. Thesis on artificial intelligence.',
  },
];

const certifications = [
  {
    title: 'Meta Certified Media Buying Professional',
    issuer: 'Meta',
    validity: 'Renewed in 2026 · valid through 2027',
    badgeName: 'meta-media-buying',
    verifyUrl: 'https://www.credly.com/badges/9670c461-061d-45f7-9eb1-cb1ac1af366f/public_url',
  },
  {
    title: 'Google Ads Search Certification',
    issuer: 'Google',
    validity: 'Renewed in 2026 · valid through 2027',
    badgeName: 'google-ads-search',
    verifyUrl: 'https://skillshop.credential.net/93e395c1-dc3a-471a-bf8c-a5fdbfc66709#acc.Q4cxfne5',
  },
  {
    title: 'Google Ads Display Certification',
    issuer: 'Google',
    validity: 'Renewed in 2026 · valid through 2027',
    badgeName: 'google-ads-display',
    verifyUrl: 'https://skillshop.credential.net/60f9d544-7bba-4d4a-8444-c8a8897826de#acc.8wjsMQ0C',
  },
];

const keyFacts = [
  { value: `${yearsActive}+`, label: 'years in digital marketing' },
  { value: String(certifications.length), label: 'active certifications' },
  { value: String(caseStudiesEn.length), label: 'published case studies' },
  { value: 'Google · Meta', label: 'core channels' },
];
---
<BaseLayout
  title="Experience"
  description="Edoardo Rossi's professional path: digital advertising in an agency, B2B marketing, education in communication and digital marketing."
  translated
>
  <section class="intro container">
    <p class="eyebrow">Experience</p>
    <h1>From in-house marketing at a B2B company to managing a client portfolio in an agency.</h1>
    <KeyFacts facts={keyFacts} />
  </section>

  <section class="container timeline" aria-label="Professional experience">
    <h2 class="section-label mono">Professional path</h2>
    {roles.map((role) => (
      <article class="role">
        <p class="mono period">{role.period}</p>
        <div>
          <h3>{role.title}</h3>
          <p class="org">{role.org}</p>
          <ul>
            {role.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </section>

  <section class="container timeline" aria-label="Education">
    <h2 class="section-label mono">Education</h2>
    {education.map((ed) => (
      <article class="role">
        <p class="mono period">{ed.period}</p>
        <div>
          <h3>{ed.title}</h3>
          <p class="org">{ed.points}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="container timeline" aria-label="Certifications">
    <h2 class="section-label mono">Certifications</h2>
    <div class="cert-grid">
      {certifications.map((cert) => (
        <a class="cert-card" href={cert.verifyUrl} target="_blank" rel="noopener noreferrer">
          <div class="cert-badge">
            <picture>
              <source srcset={`${base}badges/${cert.badgeName}.webp`} type="image/webp" />
              <img
                src={`${base}badges/${cert.badgeName}.png`}
                alt={`Badge: ${cert.title}`}
                loading="lazy"
                width="150"
                height="150"
              />
            </picture>
          </div>
          <p class="mono cert-issuer">{cert.issuer}</p>
          <h3>{cert.title}</h3>
          <p class="cert-validity">{cert.validity}</p>
          <p class="cert-verify card-cta">Verify credential →</p>
        </a>
      ))}
    </div>
  </section>

  <ClosingCTA />
</BaseLayout>

<style>
  .intro { padding-block: var(--space-6) var(--space-4); max-width: 46rem; }

  .timeline { padding-bottom: var(--space-4); }
  .section-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
    border-bottom: var(--border);
    padding-bottom: var(--space-1);
    margin-bottom: var(--space-3);
  }
  .role {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .period { color: var(--color-accent); font-size: 0.9rem; }
  .role h3 { margin-bottom: 0.15rem; }
  .org { font-size: 0.9rem; color: var(--color-ink-soft); margin-bottom: var(--space-1); }
  .role ul { margin: 0; padding-left: 1.1rem; color: var(--color-ink-soft); }
  .role li { margin-bottom: 0.4rem; font-size: 0.95rem; }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-4);
  }
  .cert-card {
    display: block;
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-3);
    text-decoration: none;
    color: var(--color-ink);
  }
  .cert-card:hover { border-color: var(--color-accent); }
  .cert-badge {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 160px;
    margin-bottom: var(--space-2);
  }
  .cert-badge img { max-width: 100%; height: auto; }
  .cert-issuer {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }
  .cert-card h3 { font-size: 1rem; margin-bottom: 0.4rem; }
  .cert-validity { font-size: 0.85rem; color: var(--color-ink-soft); margin: 0 0 0.6rem 0; }
  .cert-verify {
    font-size: 0.85rem;
    margin: 0;
  }
  .cert-card:hover .cert-verify {
    color: var(--color-accent);
    text-decoration: underline;
    transform: scale(1.04);
  }

  @media (max-width: 780px) {
    .cert-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .role { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
