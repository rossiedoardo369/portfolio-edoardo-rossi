---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const faqs = [
  {
    q: 'What kind of clients does Edoardo Rossi work with?',
    a: 'Agencies, companies, and in-house teams looking for a measured approach: Google and Meta campaigns tracked from first contact through to business outcome, not just the click.',
  },
  {
    q: 'Why are all the case studies in the dental industry?',
    a: 'It’s a deliberate vertical specialization, not a limitation. The method — direct discovery, end-to-end measurement, CRM integration — applies the same way to other regulated or high-lead-value industries.',
  },
  {
    q: 'Does he work with clients outside Italy?',
    a: 'Yes. That’s exactly why this site is bilingual: he’s open to remote collaborations with clients and teams who work in English, compatible time zones included.',
  },
  {
    q: 'Which advertising channels does he manage?',
    a: 'Mainly Google Ads (Search, Performance Max, Display) and Meta Ads, with GA4/Google Tag Manager measurement and CRM integration whenever a lead needs tracking past the click.',
  },
  {
    q: 'What’s the best way to reach him?',
    a: 'Email or LinkedIn — the links are right below.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Contact"
  description="Get in touch with Edoardo Rossi for collaborations, projects and job opportunities in performance marketing and digital strategy."
  translated
>
  <section class="contact container">
    <p class="eyebrow">Contact</p>
    <h1>If how I work convinces you, let's talk.</h1>
    <p class="lede">
      I'm open to working with any kind of organization — agencies, companies, in-house teams —
      interested not just in the skills I bring, but in how I work: method, measurement, honesty
      about results. If you've read the <a href={`${base}en/work/`}>case studies</a> and this
      sounds like your kind of approach, let's go from there.
    </p>

    <div class="channels">
      <a class="channel fade-in" href="mailto:rossi.edoardo369@gmail.com">
        <p class="mono channel-label">Email</p>
        <p class="channel-value">rossi.edoardo369@gmail.com</p>
      </a>
      <a class="channel fade-in" style="--delay: 80ms" href="https://www.linkedin.com/in/rossiedoardo369" target="_blank" rel="noopener">
        <p class="mono channel-label">LinkedIn</p>
        <p class="channel-value">linkedin.com/in/rossiedoardo369</p>
      </a>
    </div>

    <div class="faq">
      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>

<style>
  .contact { padding-block: var(--space-6); max-width: 46rem; }
  .lede { font-size: 1.15rem; }

  .channels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .channel {
    display: block;
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-3);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.1s ease;
  }
  .channel:hover { border-color: var(--color-accent); }
  .channel:active { transform: scale(0.98); }
  .channel-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }
  .channel-value {
    margin: 0;
    font-size: 1rem;
    color: var(--color-ink);
    text-decoration: none;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }
  .channel:hover .channel-value { text-decoration: underline; }

  @media (max-width: 640px) {
    .channels { grid-template-columns: 1fr; }
  }

  .faq {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--border);
  }
  .faq h2 { margin-bottom: var(--space-3); }
  .faq-item {
    padding-block: var(--space-2);
    border-top: var(--border);
  }
  .faq-item:first-of-type { border-top: none; }
  .faq-item h3 { font-size: 1rem; margin-bottom: 0.3rem; }
  .faq-item p { margin: 0; font-size: 0.95rem; }
</style>
