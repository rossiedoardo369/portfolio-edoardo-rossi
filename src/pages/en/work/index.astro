---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClosingCTA from '../../../components/ClosingCTA.astro';
import { caseStudiesEn } from '../../../data/case-studies.js';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<BaseLayout
  title={t('work.title')}
  description={t('work.description')}
  translated
>
  <section class="intro container">
    <p class="eyebrow">{t('work.eyebrow')}</p>
    <h1>{t('work.h1')}</h1>
    <p class="lede">{t('work.lede')}</p>
  </section>

  <section class="container case-grid" aria-label={t('work.aria')}>
    {caseStudiesEn.map((c, i) => (
      <a class="case-card fade-in" style={`--delay: ${i * 80}ms`} href={`${base}en/work/${c.slug}/`}>
        <p class="eyebrow">{c.eyebrow}</p>
        <h2>{c.title}</h2>
        <p class="summary">{c.summary}</p>
        <p class="mono case-metric">{c.metric} <span class="metric-label">{c.metricLabel}</span></p>
        <span class="read-more card-cta">{t('work.cta')}</span>
      </a>
    ))}
  </section>

  <ClosingCTA />
</BaseLayout>

<style>
  .intro { padding-block: var(--space-6) var(--space-4); max-width: 46rem; }
  .lede { font-size: 1.15rem; }

  .case-grid {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-5);
  }
  .case-card {
    display: block;
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-4);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.1s ease;
  }
  .case-card:hover { border-color: var(--color-accent); }
  .case-card:active { transform: scale(0.99); }
  .case-card h2 { font-size: 1.4rem; margin-top: var(--space-1); }
  .summary { max-width: 44rem; }
  .case-metric {
    color: var(--color-accent);
    font-size: 1.4rem;
    margin: var(--space-2) 0 var(--space-2) 0;
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .read-more { font-size: 0.95rem; }
  .case-card:hover .read-more {
    color: var(--color-accent);
    text-decoration: underline;
    transform: scale(1.04);
  }
</style>
