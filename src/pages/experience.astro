---
import BaseLayout from '../layouts/BaseLayout.astro';

const roles = [
  {
    period: '2025 — oggi',
    title: 'Digital Advertising Specialist',
    org: 'Marketing Therapy — agenzia di marketing',
    points: [
      'Gestione di campagne Google e Meta su un portafoglio multi-cliente, dalla strategia alla reportistica.',
      'Tracciamento e analisi dei dati con GTM e GA4, integrazione con CRM.',
      'Discovery con i clienti, copywriting delle campagne, script video e coordinamento con videomaker e team creativo.',
      'Formazione dei team dei clienti sulla gestione dei lead e costruzione di flussi di automazione.',
    ],
  },
  {
    period: '2023 — 2024',
    title: 'Junior Digital Marketing Specialist',
    org: 'Floris s.r.l. — azienda B2B',
    points: [
      'Supporto all\u2019ideazione di strategie di marketing online e offline in un settore B2B complesso.',
      'Ottimizzazione CRO attraverso interventi su UX e UI.',
      'Assistenza nel tracciamento e nell\u2019analisi dei dati.',
    ],
  },
  {
    period: '2021 — 2023',
    title: 'Digital Marketing Intern',
    org: 'Floris s.r.l.',
    points: [
      'Creazione di contenuti per i canali social aziendali (Meta, LinkedIn, blog).',
      'Strategie di lead generation tramite email marketing e campagne PPC.',
      'Gestione del sito web aziendale.',
    ],
  },
];

const education = [
  {
    period: '2021 — 2023',
    title: 'Attestato Tecnico Superiore in Digital Marketing',
    points: 'Fondamenti del marketing, progetti applicati, stage formativi in azienda.',
  },
  {
    period: '2018 — 2022',
    title: 'Laurea in Scienze della Comunicazione',
    points: 'Aspetti cognitivi della comunicazione, strategie di linguaggio persuasivo per media classici e digitali. Tesi di laurea sull\u2019intelligenza artificiale.',
  },
];

const certifications = [
  {
    title: 'Meta Certified Media Buying Professional',
    issuer: 'Meta',
    validity: 'Rinnovata nel 2026 · valida fino al 2027',
    badgeImage: null,
    verifyUrl: 'https://www.credly.com/badges/9670c461-061d-45f7-9eb1-cb1ac1af366f/public_url',
  },
  {
    title: 'Google Ads Search Certification',
    issuer: 'Google',
    validity: 'Rinnovata nel 2026 · valida fino al 2027',
    badgeImage: 'https://api.accredible.com/v1/frontend/credential_website_embed_image/badge/172388976',
    verifyUrl: 'https://skillshop.credential.net/93e395c1-dc3a-471a-bf8c-a5fdbfc66709#acc.Q4cxfne5',
  },
  {
    title: 'Google Ads Display Certification',
    issuer: 'Google',
    validity: 'Rinnovata nel 2026 · valida fino al 2027',
    badgeImage: 'https://api.accredible.com/v1/frontend/credential_website_embed_image/badge/173777092',
    verifyUrl: 'https://skillshop.credential.net/60f9d544-7bba-4d4a-8444-c8a8897826de#acc.8wjsMQ0C',
  },
];
---
<BaseLayout
  title="Esperienza"
  description="Il percorso professionale di Edoardo Rossi: digital advertising in agenzia, marketing B2B, formazione in comunicazione e digital marketing."
>
  <section class="intro container">
    <p class="eyebrow">Esperienza</p>
    <h1>Dal marketing interno di un'azienda B2B alla gestione di un portafoglio clienti in agenzia.</h1>
  </section>

  <section class="container timeline" aria-label="Esperienza professionale">
    <h2 class="section-label mono">Percorso professionale</h2>
    {roles.map((role) => (
      <article class="role">
        <p class="mono period">{role.period}</p>
        <div>
          <h3>{role.title}</h3>
          <p class="org">{role.org}</p>
          <ul>
            {role.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </section>

  <section class="container timeline" aria-label="Formazione">
    <h2 class="section-label mono">Formazione</h2>
    {education.map((ed) => (
      <article class="role">
        <p class="mono period">{ed.period}</p>
        <div>
          <h3>{ed.title}</h3>
          <p class="org">{ed.points}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="container timeline" aria-label="Certificazioni">
    <h2 class="section-label mono">Certificazioni</h2>
    <div class="cert-grid">
      {certifications.map((cert) => (
        <a class="cert-card" href={cert.verifyUrl} target="_blank" rel="noopener noreferrer">
          <div class="cert-badge">
            {cert.badgeImage && (
              <img src={cert.badgeImage} alt={`Badge: ${cert.title}`} loading="lazy" width="150" height="150" />
            )}
          </div>
          <p class="mono cert-issuer">{cert.issuer}</p>
          <h3>{cert.title}</h3>
          <p class="cert-validity">{cert.validity}</p>
          <p class="cert-verify">Verifica la credenziale →</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: var(--space-6) var(--space-4); max-width: 46rem; }

  .timeline { padding-bottom: var(--space-4); }
  .section-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
    border-bottom: var(--border);
    padding-bottom: var(--space-1);
    margin-bottom: var(--space-3);
  }
  .role {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .period { color: var(--color-accent); font-size: 0.9rem; }
  .role h3 { margin-bottom: 0.15rem; }
  .org { font-size: 0.9rem; color: var(--color-ink-soft); margin-bottom: var(--space-1); }
  .role ul { margin: 0; padding-left: 1.1rem; color: var(--color-ink-soft); }
  .role li { margin-bottom: 0.4rem; font-size: 0.95rem; }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-4);
  }
  .cert-card {
    display: block;
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-3);
    text-decoration: none;
    color: var(--color-ink);
  }
  .cert-card:hover { border-color: var(--color-accent); }
  .cert-badge {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 160px;
    margin-bottom: var(--space-2);
  }
  .cert-badge img { max-width: 100%; height: auto; }
  .cert-issuer {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }
  .cert-card h3 { font-size: 1rem; margin-bottom: 0.4rem; }
  .cert-validity { font-size: 0.85rem; color: var(--color-ink-soft); margin: 0 0 0.6rem 0; }
  .cert-verify {
    font-size: 0.85rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin: 0;
  }

  @media (max-width: 780px) {
    .cert-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .role { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
