---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import { caseStudies } from '../../data/case-studies.js';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Lavori selezionati"
  description="Case study di performance marketing: misurazione end-to-end, posizionamento strategico, CRM e automazione. Numeri reali, clienti anonimizzati."
  translated
>
  <section class="intro container">
    <p class="eyebrow">Lavori selezionati</p>
    <h1>Cinque problemi diversi, lo stesso metodo.</h1>
    <p class="lede">
      Ogni caso studio parte da un problema di business reale e arriva a un risultato misurato.
      I dati sono reali; i clienti sono anonimizzati per riservatezza.
    </p>
  </section>

  <section class="container case-grid" aria-label="Elenco dei case study">
    {caseStudies.map((c) => (
      <a class="case-card" href={`${base}work/${c.slug}/`}>
        <p class="eyebrow">{c.eyebrow}</p>
        <h2>{c.title}</h2>
        <p class="summary">{c.summary}</p>
        <p class="mono case-metric">{c.metric} <span class="metric-label">{c.metricLabel}</span></p>
        <span class="read-more card-cta">Leggi il caso studio →</span>
      </a>
    ))}
  </section>

  <ClosingCTA />
</BaseLayout>

<style>
  .intro { padding-block: var(--space-6) var(--space-4); max-width: 46rem; }
  .lede { font-size: 1.15rem; }

  .case-grid {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-5);
  }
  .case-card {
    display: block;
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-4);
    text-decoration: none;
  }
  .case-card:hover { border-color: var(--color-accent); }
  .case-card h2 { font-size: 1.4rem; margin-top: var(--space-1); }
  .summary { max-width: 44rem; }
  .case-metric {
    color: var(--color-accent);
    font-size: 1.4rem;
    margin: var(--space-2) 0 var(--space-2) 0;
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .read-more { font-size: 0.95rem; }
  .case-card:hover .read-more {
    color: var(--color-accent);
    text-decoration: underline;
    transform: scale(1.04);
  }
</style>
