---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const cases = [
  {
    href: `${base}work/eventi-multisede/`,
    eyebrow: 'Meta Ads · Misurazione end-to-end',
    title: 'Trasformare un format di eventi ricorrenti in un canale di acquisizione misurabile',
    summary:
      'Un programma di eventi replicato su una rete di 6 sedi, misurato dal primo clic fino al cliente acquisito — con formazione del team interno sulla gestione dei lead.',
    metric: '13,55×',
    metricLabel: 'ROAS · 2024',
  },
  {
    href: `${base}work/posizionamento-specialistico/`,
    eyebrow: 'Strategia · Copywriting · Funnel',
    title: 'Costruire un posizionamento specialistico, dalla discovery alla chiusura del preventivo',
    summary:
      'Un servizio complesso da spiegare, trasformato in un percorso comprensibile: discovery col titolare, 8 varianti di copy, protocollo di vendita post-lead.',
    metric: '8,53×',
    metricLabel: 'ROAS sulla spesa pubblicitaria',
  },
  {
    href: `${base}work/protocollo-crm/`,
    eyebrow: 'Posizionamento · CRM · Automazione',
    title: 'Da diagnosi complessa a fatturato misurabile: posizionamento e automazione nella stessa strategia',
    summary:
      'Un protocollo proprietario che ha più che raddoppiato il tasso di chiusura, e una campagna con CRM e automazioni WhatsApp per non disperdere un solo lead.',
    metric: '+600%',
    metricLabel: 'fatturato su una linea di servizio · 2024 → 2025',
  },
  {
    href: 'territorio-bilingue/',
    eyebrow: 'Google Ads · Meta Ads · Comunicazione bilingue',
    title: 'Local marketing in un territorio bilingue: tre sedi, due lingue, un solo sistema',
    summary:
      'Tre sedi, due lingue e bacini con potenziale molto diverso: una presenza Search e Social bilingue che ha dimezzato il costo per lead a parità di format.',
    metric: '−53%',
    metricLabel: 'costo per lead · 2025 → 2026',
  },
  {
    href: `${base}work/capacita-operativa/`,
    eyebrow: 'Google Ads · Meta Ads · Attribuzione',
    title: "Quando l'advertising supera la capacità dell'azienda",
    summary:
      'Ticket alti, volumi bassi, tracciamento separato per rendere il ritorno difendibile — fino a saturare l\u2019agenda del cliente e consigliargli di fermarsi.',
    metric: '37',
    metricLabel: 'pazienti acquisiti in quattro mesi',
  },
];
---
<BaseLayout
  title="Lavori selezionati"
  description="Case study di performance marketing: misurazione end-to-end, posizionamento strategico, CRM e automazione. Numeri reali, clienti anonimizzati."
>
  <section class="intro container">
    <p class="eyebrow">Lavori selezionati</p>
    <h1>Cinque problemi diversi, lo stesso metodo.</h1>
    <p class="lede">
      Ogni caso studio parte da un problema di business reale e arriva a un risultato misurato.
      I dati sono reali; i clienti sono anonimizzati per riservatezza.
    </p>
  </section>

  <section class="container case-grid" aria-label="Elenco dei case study">
    {cases.map((c) => (
      <a class="case-card" href={c.href}>
        <p class="eyebrow">{c.eyebrow}</p>
        <h2>{c.title}</h2>
        <p class="summary">{c.summary}</p>
        <p class="mono case-metric">{c.metric} <span class="metric-label">{c.metricLabel}</span></p>
        <span class="read-more">Leggi il caso studio →</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .intro { padding-block: var(--space-6) var(--space-4); max-width: 46rem; }
  .lede { font-size: 1.15rem; }

  .case-grid {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-5);
  }
  .case-card {
    display: block;
    background: var(--color-surface);
    border: var(--border);
    padding: var(--space-4);
    text-decoration: none;
  }
  .case-card:hover { border-color: var(--color-accent); }
  .case-card h2 { font-size: 1.4rem; margin-top: var(--space-1); }
  .summary { max-width: 44rem; }
  .case-metric {
    color: var(--color-accent);
    font-size: 1.4rem;
    margin: var(--space-2) 0 var(--space-2) 0;
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .read-more { font-size: 0.95rem; color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
