---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, translatedPaths } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  // true solo per le pagine che hanno già una versione tradotta nell'altra
  // lingua (per ora solo la home) — evita di dichiarare alternate hreflang
  // verso pagine /en/ che non esistono ancora.
  translated?: boolean;
}

const { title, description, translated = false } = Astro.props;
const siteName = 'Edoardo Rossi — Performance Marketing & Digital Strategy';
const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}og-image.png`, Astro.site);

const pathWithoutBase = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;
const restPath = lang === 'en' ? pathWithoutBase.replace(/^en\/?/, '') : pathWithoutBase;
const itHref = new URL(`${base}${restPath}`, Astro.site).toString();
const enHref = new URL(`${base}en/${restPath}`, Astro.site).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Edoardo Rossi',
  jobTitle: 'Performance Marketing & Digital Strategy Specialist',
  url: new URL(base, Astro.site).toString(),
  email: 'mailto:rossi.edoardo369@gmail.com',
  sameAs: ['https://www.linkedin.com/in/rossiedoardo369'],
  knowsAbout: [
    'Google Ads',
    'Meta Ads',
    'Performance Marketing',
    'CRM e automazione',
    'Misurazione e tracciamento',
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      is:inline
      define:vars={{ base, currentLang: lang, currentPath: restPath, translatedPaths }}
    >
      // Reindirizza alla lingua del browser al primo arrivo su una pagina
      // sbagliata. Una scelta fatta a mano con lo switcher (salvata in
      // localStorage) vale sempre più della lingua del browser. Niente
      // redirect fuori dall'insieme delle pagine già tradotte, e i bot dei
      // motori di ricerca vengono esclusi per non interferire con
      // l'indicizzazione delle due versioni.
      (function () {
        try {
          if (translatedPaths.indexOf(currentPath) === -1) return;

          var stored = null;
          try {
            stored = localStorage.getItem('preferredLang');
          } catch (e) {}

          var targetLang = stored;
          if (targetLang !== 'it' && targetLang !== 'en') {
            var nav = (navigator.language || (navigator.languages && navigator.languages[0]) || 'it').toLowerCase();
            targetLang = nav.indexOf('it') === 0 ? 'it' : 'en';
          }

          if (targetLang === currentLang) return;

          var ua = navigator.userAgent || '';
          if (/bot|crawl|spider|slurp|googlebot|bingbot|duckduckbot|baiduspider|yandex|lighthouse|pagespeed/i.test(ua)) return;

          var dest = (targetLang === 'en' ? base + 'en/' + currentPath : base + currentPath) + location.search + location.hash;
          if (dest !== location.pathname + location.search + location.hash) {
            location.replace(dest);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    {translated && (
      <>
        <link rel="alternate" hreflang="it" href={itHref} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="x-default" href={itHref} />
      </>
    )}

    <title>{title} — {siteName}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'it_IT'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Dati strutturati -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Font: Space Grotesk (display), IBM Plex Sans (corpo), IBM Plex Mono (dati) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('skip.content')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
