---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getLangFromUrl, getPathWithoutLocale, useTranslations, translatedPaths } from '../i18n/utils';
import '../styles/global.css';
// Font self-hosted: servirli dalla CDN di Google significherebbe mandare l'IP
// del visitatore a Google prima ancora che abbia scelto sui cookie, e con una
// richiesta bloccante in più. I file arrivano dallo stesso dominio del sito.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

const siteName = 'Edoardo Rossi — Performance Marketing & Digital Strategy';

interface Props {
  title: string;
  description: string;
  // true solo per le pagine che hanno già una versione tradotta nell'altra
  // lingua (per ora solo la home) — evita di dichiarare alternate hreflang
  // verso pagine /en/ che non esistono ancora.
  translated?: boolean;
  // Le pagine con titoli lunghi (i case study) accorciano il suffisso per
  // restare entro i ~60 caratteri leggibili nei risultati di ricerca.
  titleSuffix?: string;
}

const { title, description, translated = false, titleSuffix = siteName } = Astro.props;
const fullTitle = `${title} — ${titleSuffix}`;
const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}${lang === 'en' ? 'og-image-en.png' : 'og-image.png'}`, Astro.site);

const restPath = getPathWithoutLocale(Astro.url.pathname);
const itHref = new URL(`${base}it/${restPath}`, Astro.site).toString();
const enHref = new URL(`${base}en/${restPath}`, Astro.site).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Edoardo Rossi',
  jobTitle: 'Performance Marketing & Digital Strategy Specialist',
  url: new URL(base, Astro.site).toString(),
  email: 'mailto:rossi.edoardo369@gmail.com',
  sameAs: ['https://www.linkedin.com/in/rossiedoardo369'],
  knowsAbout: t('schema.knowsAbout').split(','),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Interruttore per gli stati iniziali delle animazioni (.fade-in, metriche
         del count-up): nascondere da CSS significa nascondere per sempre se lo
         script non parte. Con questa classe lo stato "nascosto" esiste solo
         quando il JS c'è. Deve essere inline e in testa: uno script a modulo è
         differito e il contenuto lampeggerebbe prima di sparire. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Consent Mode: stato di default negato finché l'utente non sceglie
         dal banner, e riapplicazione immediata di una scelta già salvata —
         deve girare prima che GTM carichi qualsiasi tag. Usa gtag() nella
         forma canonica (non un push di array grezzo): è il pattern che GTM
         riconosce in modo affidabile per il consenso di default. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
      try {
        var saved = JSON.parse(localStorage.getItem('cookieConsent') || 'null');
        if (saved) {
          gtag('consent', 'update', {
            analytics_storage: saved.analytics ? 'granted' : 'denied',
            ad_storage: saved.marketing ? 'granted' : 'denied',
            ad_user_data: saved.marketing ? 'granted' : 'denied',
            ad_personalization: saved.marketing ? 'granted' : 'denied',
          });
        }
      } catch (e) {}
    </script>

    <script
      is:inline
      define:vars={{ base, currentLang: lang, currentPath: restPath, translatedPaths }}
    >
      // Reindirizza alla lingua del browser al primo arrivo su una pagina
      // sbagliata. Una scelta fatta a mano con lo switcher (salvata in
      // localStorage) vale sempre più della lingua del browser. Niente
      // redirect fuori dall'insieme delle pagine già tradotte, e i bot dei
      // motori di ricerca vengono esclusi per non interferire con
      // l'indicizzazione delle due versioni.
      (function () {
        try {
          if (translatedPaths.indexOf(currentPath) === -1) return;

          var stored = null;
          try {
            stored = localStorage.getItem('preferredLang');
          } catch (e) {}

          var targetLang = stored;
          if (targetLang !== 'it' && targetLang !== 'en') {
            var nav = (navigator.language || (navigator.languages && navigator.languages[0]) || 'it').toLowerCase();
            targetLang = nav.indexOf('it') === 0 ? 'it' : 'en';
          }

          if (targetLang === currentLang) return;

          var ua = navigator.userAgent || '';
          if (/bot|crawl|spider|slurp|googlebot|bingbot|duckduckbot|baiduspider|yandex|lighthouse|pagespeed/i.test(ua)) return;

          var dest = base + targetLang + '/' + currentPath + location.search + location.hash;
          if (dest !== location.pathname + location.search + location.hash) {
            location.replace(dest);
          }
        } catch (e) {}
      })();
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-KJV984JR');
    </script>
    <!-- End Google Tag Manager -->
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="canonical" href={canonicalURL} />
    {translated && (
      <>
        <link rel="alternate" hreflang="it" href={itHref} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="x-default" href={itHref} />
      </>
    )}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'it_IT'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Dati strutturati -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-KJV984JR"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main" class="skip-link">{t('skip.content')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <script>
      import { prefersReducedMotion } from '../scripts/motion';

      // Chi ha chiesto meno movimento non deve vedere né la rivelazione parola
      // per parola né il fade-in: queste animazioni girano via
      // requestAnimationFrame e la regola CSS @media non le tocca (vedi
      // global.css), quindi la preferenza va rispettata a mano qui.
      const reduceMotion = prefersReducedMotion();

      // Rivelazione parola per parola degli h1 (componente RevealH1) al
      // caricamento della pagina, non allo scroll: sono sempre nella parte
      // già visibile della pagina appena questa si apre. L'opacity iniziale
      // viene impostata da qui, non da CSS: se lo script non parte per
      // qualunque motivo, il testo resta semplicemente visibile da subito
      // invece di sparire.
      const revealWordEls = reduceMotion
        ? ([] as HTMLElement[])
        : Array.from(document.querySelectorAll<HTMLElement>('h1 .word'));
      revealWordEls.forEach((el, i) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(6px)';
        const duration = 300;
        function frame(now: number, start: number) {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.style.opacity = String(eased);
          el.style.transform = `translateY(${(1 - eased) * 6}px)`;
          if (t < 1) {
            requestAnimationFrame((n) => frame(n, start));
          } else {
            el.style.opacity = '';
            el.style.transform = '';
          }
        }
        setTimeout(() => requestAnimationFrame((now) => frame(now, now)), i * 25);
      });

      // Fade-in on-scroll condiviso da tutte le pagine: qualunque elemento
      // con class="fade-in" (più opzionale style="--delay: Nms") viene
      // rivelato al primo ingresso in viewport. Usa visualViewport.height
      // su iOS per l'altezza realmente visibile (innerHeight su Safari
      // include l'area dietro la barra del browser).
      function animateFade(el: HTMLElement, delayMs: number) {
        const duration = 450;
        function frame(now: number, start: number) {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.style.opacity = String(eased);
          el.style.transform = `translateY(${(1 - eased) * 8}px)`;
          if (t < 1) {
            requestAnimationFrame((n) => frame(n, start));
          } else {
            el.style.opacity = '';
            el.style.transform = '';
            el.classList.remove('fade-in');
          }
        }
        const run = () => requestAnimationFrame((now) => frame(now, now));
        if (delayMs > 0) {
          setTimeout(run, delayMs);
        } else {
          run();
        }
      }

      const fadeEls = document.querySelectorAll<HTMLElement>('.fade-in');
      if (reduceMotion) {
        // Togliere la classe basta a rendere tutto visibile: lo stato nascosto
        // vive nella regola html.js .fade-in.
        fadeEls.forEach((el) => el.classList.remove('fade-in'));
      } else if (fadeEls.length) {
        const vh = window.visualViewport?.height ?? window.innerHeight;
        const toObserve: HTMLElement[] = [];

        fadeEls.forEach((el) => {
          if (el.getBoundingClientRect().top < vh * 0.75) {
            el.classList.remove('fade-in');
          } else {
            toObserve.push(el);
          }
        });

        if (toObserve.length) {
          const fadeObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const delay = parseFloat(el.style.getPropertyValue('--delay')) || 0;
                animateFade(el, delay);
                fadeObserver.unobserve(el);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -80px 0px' });
          toObserve.forEach((el) => fadeObserver.observe(el));
        }
      }
    </script>
  </body>
</html>
