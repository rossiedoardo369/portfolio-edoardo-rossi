---
import BaseLayout from './BaseLayout.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { caseStudies, caseStudiesEn } from '../data/case-studies.js';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface SnapshotItem {
  label: string;
  value: string;
}

interface ResultItem {
  metric: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  snapshot: SnapshotItem[];
  results: ResultItem[];
}

const { title, description, eyebrow, snapshot, results } = Astro.props;
const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const list = lang === 'en' ? caseStudiesEn : caseStudies;
const workBase = `${base}${lang}/work/`;

const segments = Astro.url.pathname.split('/').filter(Boolean);
const currentSlug = segments[segments.length - 1];
const currentIndex = list.findIndex((c) => c.slug === currentSlug);
const prevCase = list[(currentIndex - 1 + list.length) % list.length];
const nextCase = list[(currentIndex + 1) % list.length];
---
<BaseLayout title={title} description={description} translated>
  <article class="case-study container">
    <a class="back-link" href={workBase}>← {t('case.back')}</a>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>

    <dl class="snapshot fade-in">
      {snapshot.map((item) => (
        <div class="snapshot-item">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>

    <div class="results" aria-label={t('case.resultsAria')}>
      {results.map((item, i) => (
        <div class="result-card fade-in" style={`--delay: ${i * 80}ms`}>
          <p class="mono metric" data-value={item.metric}>0</p>
          <p class="result-label">{item.label}</p>
        </div>
      ))}
    </div>

    <div class="body">
      <slot />
    </div>

    <ClosingCTA nested />

    <nav class="case-pagination" aria-label={t('case.paginationAria')}>
      <a class="case-pagination-link prev" href={`${workBase}${prevCase.slug}/`}>
        <p class="eyebrow">← {t('case.prev')}</p>
        <p class="case-pagination-title">{prevCase.title}</p>
      </a>
      <a class="case-pagination-link next" href={`${workBase}${nextCase.slug}/`}>
        <p class="eyebrow">{t('case.next')} →</p>
        <p class="case-pagination-title">{nextCase.title}</p>
      </a>
    </nav>
  </article>
</BaseLayout>

<script>
  // Count-up sui risultati (result-card) al primo ingresso in viewport.
  // Stessa logica del contatore in home: su schermi stretti i risultati
  // sono impilati e partono uno alla volta; su schermi larghi partono
  // tutti insieme non appena il primo entra in vista.
  function animateValue(el: HTMLElement) {
    const raw = el.dataset.value || '';
    const isEn = document.documentElement.lang === 'en';
    const decimalSep = isEn ? '.' : ',';
    const match = raw.match(isEn ? /^([+−~]?)(\d+(?:\.\d+)?)(.*)$/ : /^([+−~]?)(\d+(?:,\d+)?)(.*)$/);
    if (!match) {
      el.textContent = raw;
      return;
    }
    const [, prefix, numStr, suffix] = match;
    const decimals = numStr.includes(decimalSep) ? numStr.split(decimalSep)[1].length : 0;
    const target = parseFloat(numStr.replace(',', '.'));
    const duration = 1500;
    let start: number | null = null;

    function frame(now: number) {
      if (start === null) start = now;
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      const current = target * eased;
      el.textContent = prefix + current.toLocaleString(isEn ? 'en-US' : 'it-IT', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      }) + suffix;
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  const metrics = document.querySelectorAll<HTMLElement>('.result-card .metric');
  const isStacked = window.matchMedia('(max-width: 640px)').matches;

  if (isStacked) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateValue(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 1 });
    metrics.forEach((el) => observer.observe(el));
  } else {
    // Stessa soglia/rootMargin del fade-in condiviso (BaseLayout): con
    // criteri diversi i due observer potevano scattare in momenti
    // diversi durante lo scroll, facendo terminare il conteggio prima
    // che la card fosse effettivamente a schermo.
    const firstMetric = metrics[0];
    if (firstMetric) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            metrics.forEach((el) => animateValue(el));
            observer.disconnect();
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -80px 0px' });
      observer.observe(firstMetric);
    }
  }
</script>

<style>
  .case-study {
    padding-block: var(--space-5) var(--space-6);
    max-width: 46rem;
  }
  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-3);
  }
  h1 { margin-top: 0.3rem; }

  .snapshot {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-2) var(--space-3);
    margin: var(--space-4) 0 0 0;
    padding: var(--space-3);
    background: var(--color-surface);
    border: var(--border);
  }
  .snapshot-item dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-soft);
    margin-bottom: 0.2rem;
  }
  .snapshot-item dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .results {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-3) var(--space-4);
    margin: var(--space-4) 0 var(--space-5) 0;
    border-top: var(--border);
    border-bottom: var(--border);
  }
  .result-card { padding: var(--space-2); }
  .metric {
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--color-accent);
    margin: 0;
  }
  .result-label { font-size: 0.85rem; margin: 0.2rem 0 0 0; }

  .body :global(h2) { margin-top: var(--space-5); }
  .body :global(.open-point) {
    border-left: 3px solid var(--color-caution);
    padding-left: var(--space-2);
    color: var(--color-ink-soft);
    font-style: italic;
  }

  .case-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .case-pagination-link {
    display: block;
    padding: var(--space-3);
    background: var(--color-surface);
    border: var(--border);
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color 0.2s ease, transform 0.1s ease;
  }
  .case-pagination-link:hover { border-color: var(--color-accent); }
  .case-pagination-link:active { transform: scale(0.98); }
  .case-pagination-link.next { text-align: right; }
  .case-pagination-title {
    margin: 0.3rem 0 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    .results { grid-template-columns: 1fr; }
    .case-pagination { grid-template-columns: 1fr; }
    .case-pagination-link.next { text-align: left; }
  }
</style>
